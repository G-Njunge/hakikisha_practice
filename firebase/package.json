{
  "name": "hakikisha-firebase",
  "private": true,
  "scripts": {
    "emulators": "node scripts/firebase.mjs emulators:start",
    "seed": "tsx scripts/seed.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "test:rules": "node scripts/firebase.mjs emulators:exec --only firestore \"vitest run\"",
    "test:e2e": "node scripts/firebase.mjs emulators:exec --only firestore \"tsx scripts/seed.ts && tsx scripts/smoke.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
